{"name":"@ende/math","version":"2026.10.15","modules":[{"path":"","file":"@ende/math/2026.10.15/mod.ts","doc":{"doc":"Math functions such as modulo and clamp.\n\n```ts\nimport { clamp, modulo } from \"@ende/math\";\nimport { assertEquals } from \"@ende/assert\";\n\nfor (let n = -3; n <= 3; ++n) {\n const val = n * 12 + 5;\n // 5 o'clock is always 5 o'clock, no matter how many twelve-hour cycles you add or remove\n assertEquals(modulo(val, 12), 5);\n assertEquals(clamp(val, 0, 11), n === 0 ? 5 : n > 0 ? 11 : 0);\n}\n```\n","tags":[{"kind":"module"}]},"symbols":[{"name":"clamp","declarations":[{"location":{"file":"@ende/math/2026.10.15/clamp.ts","line":22},"declarationKind":"export","jsDoc":{"doc":"Clamp a number within the inclusive [min, max] range.\n","tags":[{"kind":"param","name":"num","doc":"The number to be clamped"},{"kind":"param","name":"min","doc":"The minimum value"},{"kind":"param","name":"max","doc":"The maximum value"},{"kind":"return","doc":"The clamped number\n"},{"kind":"example","doc":"Usage\n```ts\nimport { clamp } from \"@ende/math/clamp\";\nimport { assertEquals } from \"@ende/assert\";\nassertEquals(clamp(5, 1, 10), 5);\nassertEquals(clamp(-5, 1, 10), 1);\nassertEquals(clamp(15, 1, 10), 10);\n```"}]},"kind":"function","def":{"params":[{"kind":"identifier","name":"num","optional":false,"tsType":{"kind":"keyword","value":"number"}},{"kind":"identifier","name":"min","optional":false,"tsType":{"kind":"keyword","value":"number"}},{"kind":"identifier","name":"max","optional":false,"tsType":{"kind":"keyword","value":"number"}}],"returnType":{"kind":"keyword","value":"number"},"hasBody":true}}]},{"name":"modulo","declarations":[{"location":{"file":"@ende/math/2026.10.15/modulo.ts","line":23},"declarationKind":"export","jsDoc":{"doc":"Computes the floored modulo of a number.\n","tags":[{"kind":"param","name":"num","doc":"The number to be reduced"},{"kind":"param","name":"modulus","doc":"The modulus"},{"kind":"return","doc":"The reduced number\n"},{"kind"